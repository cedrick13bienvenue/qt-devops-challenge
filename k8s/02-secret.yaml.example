apiVersion: v1
kind: Secret
metadata:
  name: projecthub-secret
  namespace: qt-spring-app
  labels:
    app.kubernetes.io/part-of: projecthub
type: Opaque
stringData:
  JWT_SECRET: change-me-generate-with-openssl-rand-hex-32
  MONGO_ROOT_USERNAME: projecthub
  MONGO_ROOT_PASSWORD: change-me
  MONGO_URI: mongodb://projecthub:change-me@mongodb-0.mongodb.qt-spring-app.svc.cluster.local:27017/?authSource=admin
  VALKEY_PASSWORD: change-me
